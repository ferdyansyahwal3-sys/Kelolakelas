# Salin menjadi .env.local lalu isi sendiri dari Supabase: Project Settings > API.
# .env.local sudah diabaikan git. Jangan tempel kunci ini di chat atau commit.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya server. JANGAN beri awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- B5 notifikasi email (Resend). Semua opsional: tanpa RESEND_API_KEY tombol "Kirim email" menampilkan pesan dan WA tetap jalan. ---
# Kunci dari resend.com > API Keys. Hanya server, JANGAN awalan NEXT_PUBLIC_.
RESEND_API_KEY=
# Pengirim, mis. "KelolaKelas <noreply@domainmu.id>" (domain harus terverifikasi di Resend).
# Kosong = mode uji (onboarding@resend.dev): email HANYA dikirim ke alamat di EMAIL_UJI_KE, tidak pernah ke murid.
EMAIL_DARI=
EMAIL_UJI_KE=
# Rahasia untuk rute pengingat terjadwal /api/cron/pengingat (header Authorization: Bearer <nilai>). Kosong = rute menolak.
CRON_SECRET=
# Alamat situs untuk tautan di email, mis. https://kelolakelas.id (kosong = dibaca dari header host).
NEXT_PUBLIC_SITE_URL=

# --- B6 pembayaran langganan (DuitKu). Isi SENDIRI di .env.local, jangan tempel di chat. Tanpa dua kunci pertama halaman bayar menampilkan "belum aktif". ---
# Dari dashboard DuitKu > Proyek: Merchant Code dan API Key (sandbox dulu).
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# sandbox (bawaan) atau production. Produksi hanya bila ditulis persis "production".
DUITKU_ENV=sandbox
# Opsional: alamat webhook publik. Kosong = NEXT_PUBLIC_SITE_URL + /api/duitku/callback (daftarkan juga di dashboard DuitKu).
DUITKU_CALLBACK_URL=
# Hanya uji lokal dengan server tiruan (scripts/duitku-tiruan.mjs); ditolak di production. Contoh: http://localhost:3199/webapi/api/merchant
DUITKU_API_URL=
